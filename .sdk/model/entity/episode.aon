# Entity: episode

main: kit: entity: episode: {

  alias: field: {}

  fields: [
    {
      name: "air_date"
      req: false
      short: "The air date of the episode"
      type: "`$STRING`"
    }
    {
      name: "characters"
      req: false
      short: "URLs to characters appearing in this episode"
      type: "`$ARRAY`"
    }
    {
      name: "director"
      req: false
      short: "The director of the episode"
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      short: "The unique identifier for the episode"
      type: "`$INTEGER`"
    }
    {
      format: "uri"
      name: "img_url"
      req: false
      short: "URL to the episode's image"
      type: "`$STRING`"
    }
    {
      name: "name"
      req: false
      short: "The name of the episode"
      type: "`$STRING`"
    }
    {
      name: "writer"
      req: false
      short: "The writer of the episode"
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "episode"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            query: [
              {
                kind: "query"
                name: "sort"
                orig: "sort"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/episode"
          segments: [
            {
              lit: "episode"
            }
          ]
          select: {
            exist: [
              "sort"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "id"
                reqd: true
                type: "`$INTEGER`"
              }
            ]
          }
          method: "GET"
          orig: "/episode/{id}"
          segments: [
            {
              lit: "episode"
            }
            {
              var: "id"
            }
          ]
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
