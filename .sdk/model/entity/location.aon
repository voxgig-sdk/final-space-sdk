# Entity: location

main: kit: entity: location: {

  alias: field: {}

  fields: [
    {
      name: "id"
      req: false
      short: "The unique identifier for the location"
      type: "`$INTEGER`"
    }
    {
      format: "uri"
      name: "img_url"
      req: false
      short: "URL to the location's image"
      type: "`$STRING`"
    }
    {
      name: "inhabitants"
      req: false
      short: "List of inhabitants of the location"
      type: "`$ARRAY`"
    }
    {
      name: "name"
      req: false
      short: "The name of the location"
      type: "`$STRING`"
    }
    {
      name: "notable_residents"
      req: false
      short: "URLs to notable residents"
      type: "`$ARRAY`"
    }
    {
      name: "type"
      req: false
      short: "The type of location"
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "location"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            query: [
              {
                kind: "query"
                name: "sort"
                orig: "sort"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/location"
          segments: [
            {
              lit: "location"
            }
          ]
          select: {
            exist: [
              "sort"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "id"
                reqd: true
                type: "`$INTEGER`"
              }
            ]
          }
          method: "GET"
          orig: "/location/{id}"
          segments: [
            {
              lit: "location"
            }
            {
              var: "id"
            }
          ]
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
