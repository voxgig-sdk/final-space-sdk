# Entity: location

main: kit: entity: location: {

  alias: field: {}

  fields: {
    id: {
      h: "Id"
      n: "id"
      r: false
      sh: "The unique identifier for the location"
      t: "`$INTEGER`"
    }
    img_url: {
      fo: "uri"
      h: "Img Url"
      n: "img_url"
      r: false
      sh: "URL to the location's image"
      t: "`$STRING`"
    }
    inhabitants: {
      h: "Inhabitants"
      n: "inhabitants"
      r: false
      sh: "List of inhabitants of the location"
      t: "`$ARRAY`"
    }
    name: {
      h: "Name"
      n: "name"
      r: false
      sh: "The name of the location"
      t: "`$STRING`"
    }
    notable_residents: {
      h: "Notable Residents"
      n: "notable_residents"
      r: false
      sh: "URLs to notable residents"
      t: "`$ARRAY`"
    }
    type: {
      h: "Type"
      n: "type"
      r: false
      sh: "The type of location"
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "location"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /location"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                k: "query"
                n: "sort"
                or: "sort"
                r: false
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/location"
          q: {
            exist: [
              "sort"
            ]
          }
          s: [
            {
              lit: "location"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /location/{id}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "id"
                r: true
                t: "`$INTEGER`"
              }
            ]
          }
          m: "GET"
          o: "/location/{id}"
          q: {
            exist: [
              "id"
            ]
          }
          s: [
            {
              lit: "location"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
